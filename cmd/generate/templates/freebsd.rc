#!/bin/sh
# Generated by cmd/generate. Do not edit.
#
# PROVIDE: [[.RCName]]
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown
#
# [[.RCName]]_enable (bool): Set to YES to start [[.Name]]. Default: NO.

. /etc/rc.subr

name=[[.RCName]]
rcvar=[[.RCName]]_enable
load_rc_config $name

: ${[[.RCName]]_enable:=NO}

[[.RCName]]_user=[[.Name]]
[[.RCName]]_env="HOME=[[.Platform.State]]"
pidfile=/var/run/[[.Name]]/[[.Name]].pid
command=/usr/sbin/daemon
command_args="-f -P ${pidfile} -r -R 5 -S -T [[.Name]] [[.Command]]"
start_precmd=[[.RCName]]_prestart

[[.RCName]]_prestart() {
	install -d -m 0750 -o [[.Name]] -g [[.Name]] /var/run/[[.Name]]
}

run_rc_command "$1"
