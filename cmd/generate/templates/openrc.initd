#!/sbin/openrc-run
# Generated by cmd/generate. Do not edit.

description=[[shell .Description]]
command=[[.Platform.Binaries]]/[[.Binary]]
command_args=[[shell (join .Service.Arguments " ")]]
command_user=[[.Name]]:[[.Name]]
supervisor=supervise-daemon
respawn_delay=5
output_log=/var/log/[[.Name]]/[[.Name]].log
error_log=/var/log/[[.Name]]/[[.Name]].log
export HOME=[[.Platform.State]]

depend() {
	need net
	after firewall
}

start_pre() {
	checkpath --directory --owner [[.Name]]:[[.Name]] --mode 0750 /var/log/[[.Name]]
}
