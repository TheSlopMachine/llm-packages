#!/sbin/openrc-run
# Generated by cmd/generate. Do not edit.

description='Self-contained OpenAI-compatible LLM routing gateway'
command=/usr/bin/llm-router
command_args='serve'
command_user=llm-router:llm-router
supervisor=supervise-daemon
respawn_delay=5
output_log=/var/log/llm-router/llm-router.log
error_log=/var/log/llm-router/llm-router.log
export HOME=/var/lib/llm-router

depend() {
	need net
	after firewall
}

start_pre() {
	checkpath --directory --owner llm-router:llm-router --mode 0750 /var/log/llm-router
}
